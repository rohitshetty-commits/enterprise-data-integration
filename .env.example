# ── AI Agent Layer Environment Variables ────────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to git.

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB persistence path (default: ./chroma_db)
CHROMA_PATH=./chroma_db

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Oracle DB connection (for live agent queries)
ORACLE_DB_URL=jdbc:oracle:thin:@localhost:1521:ORCL
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=

# Optional: GitHub token (cloud sync + Ruflo GitHub ops)
GITHUB_TOKEN=

# Cloud knowledge sync
CLOUD_SYNC_ENABLED=true
SYNC_URLS=
SYNC_GITHUB_REPO=
